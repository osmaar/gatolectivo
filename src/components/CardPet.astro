---
// src/components/CardCat.astro
import { Image } from "astro:assets";
import type { z } from 'astro:content';
import { PetApiSchema } from '~/types';

interface Props {
    pet: z.infer<typeof PetApiSchema>;
}
const { pet } = Astro.props;

if (!pet) {
    return null;
}

// CORRECCIÓN: Buscamos la imagen en 'pet.acf.main_image'
const mainImage = pet.acf?.main_image?.['pet-card-thumbnail'] || pet.acf?.main_image?.medium;

const petName = pet.title?.rendered ?? 'Mascota sin nombre';
// También corregimos la descripción para que use el campo de ACF
const petDescription = pet.acf?.short_description || pet.excerpt?.rendered || 'No hay descripción disponible.';
const petSlug = pet.slug ?? '#';
---

<article class="odd:rotate-1 even:-rotate-1 hover:rotate-0 transition hover:scale-105 duration-500 bg-white">
    <a href={`/pet/${petSlug}`} class="h-full flex flex-col">
        
        {mainImage ? (
            <Image
                src={mainImage.url}
                alt={mainImage.alt ?? petName}
                width={mainImage.width}
                height={mainImage.height}
                class:list={"w-full aspect-[6/4] object-cover rounded-t-2xl"}
                transition:name={`cat-image-${pet.id}`}
            />
        ) : (
            <div class="w-full aspect-[6/4] bg-gray-200 rounded-t-2xl flex items-center justify-center">
                <p class="text-gray-500">Foto no disponible</p>
            </div>
        )}

        <div class="px-4 pt-8 flex flex-col grow border-x-2 border-b-2 border-gray-100 rounded-b-2xl overflow-hidden">
            <h2 class="h5 tracking-wide" transition:name={`cat-title-${pet.id}`}>
                {petName}
            </h2>
            
            <div class="mt-2 mb-8 prose" transition:name={`cat-description-${pet.id}`} set:html={petDescription}></div>

            <span class="text-center px-4 py-2 -mx-4 text-white text-2xl font-bold bg-gradient-to-r from-fuchsia-500 to-teal-500 mt-auto block">
               {pet.acf?.adoption_button_text || '¡Adóptame!'}
            </span>
        </div>
    </a>
</article>