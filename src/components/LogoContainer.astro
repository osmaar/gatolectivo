---
import { Image } from "astro:assets";
import Logo from "~/assets/images/pata.svg";
import { siteSlogan } from "~/data/config.js";
---

<div class="flex items-center gap-2 lg:gap-6">
	<Image src={Logo} alt="Gatolectivo Logo" class="w-auto h-11 lg:h-19" />

	<div>
		<h1 class="text-xl lg:text-4xl font-semibold">Gatolectivo</h1>
		<p class="max-lg:hidden text-sm text-center italic">{siteSlogan}</p>
	</div>
</div>
