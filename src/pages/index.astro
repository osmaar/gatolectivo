---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Container from "~/components/Container.astro";
import { Image, Picture } from "astro:assets";
import Hero from "~/components/Hero.astro";
import { PageSchema } from "~/types"; 
import Button from "~/components/Button.astro";
import Faq from "~/components/Faq.astro";
import CallToAction from "~/components/CallToAction.astro";
import ShowPets from "~/components/ShowPets.astro";
import ShowBlogs from "~/components/ShowBlogs.astro";
import Heading from "~/components/Heading.astro";
import CatNameGenerator from "~/components/CatNameGenerator.astro";

// Images
import CatBackground from "~/assets/images/pexels-thirdman-8942612.webp";
import CatOne from "~/assets/images/pexels-chevonrossouw-2558605.jpg";
import CatTwo from "~/assets/images/pexels-minan1398-1003994.jpg";

// Faq
const faq = [
	{
		question: "What is the adoption process?",
		answer: "The adoption process is simple. You can view our available pets on our website. If you see a pet you are interested in, you can contact us to schedule a meet and greet. If you decide to adopt the pet, you will need to fill out an adoption application and pay the adoption fee. Once the adoption is complete, you can take your new pet home!",
	},
	{
		question: "What is the adoption fee?",
		answer: "The adoption fee varies depending on the pet. The fee covers the cost of spaying/neutering, vaccinations, microchipping, and other medical expenses. The fee also helps support our shelter and the care of our animals.",
	},
	{
		question: "Can I adopt a pet if I live out of state?",
		answer: "Yes, you can adopt a pet if you live out of state. However, you will need to come to our shelter to meet the pet and complete the adoption process. We do not ship pets, so you will need to pick up your new pet in person.",
	},
	{
		question: "Do you have a return policy?",
		answer: "Yes, we have a return policy. If for any reason you are unable to keep your adopted pet, you can return the pet to our shelter. We want to ensure that all of our pets find loving forever homes, so we are here to help if you need to return a pet.",
	},
];

const url = 'http://gatolectivo.local/wp-json/wp/v2/pages?slug=inicio'
const res = await fetch(url)
const json = await res.json()
const data = PageSchema.parse(json[0])
const components = data.acf_fields?.page_components ?? [];
---

<Layout 
    title={data.seo_meta.title} 
    pageTitle={`Gatolectivo - ${data.seo_meta.title}`} 
    description={data.seo_meta.description}
    image={data.seo_meta.image?.full?.url}
>
    {components.map(component => {

		switch (component.block_type) {
            
            case 'block_hero':
                const heroData = component.block_data; 
                return (
                    <Section class:list={"relative"}>

                        {heroData.background_image &&
                            <img 
                                src={heroData.background_image.url} 
                                alt={heroData.background_image.alt}
                                class="absolute inset-0 w-full h-full object-cover"
                                loading="eager"
                                fetchpriority="high"
                                width={heroData.background_image.width}
                                height={heroData.background_image.height}
                            />
                        }
                        
                        <div class="bg-gradient-to-r from-fuchsia-500/60 to-teal-500/80 absolute inset-0"></div>

                        <Container class:list={"relative z-10 h-full lg:min-h-svh lg:h-svh"}>
                            <div class="flex items-center h-full">
                                <div class="ml-auto">
                                    <div class="prose prose-xl prose-invert text-white lg:text-right text-balance">
                                        
                                        <h1 class="text-5xl lg:text-8xl mb-0">{heroData.headline}</h1>

                                        <div set:html={heroData.content} />

                                        {heroData.show_button && heroData.url_button && (
                                            <div class="not-prose mt-8">
                                                <Button url={heroData.url_button.url} color="white">
                                                    {heroData.text_button}
                                                </Button>
                                            </div>
                                        )}
                                    </div>
                                </div>
                            </div>
                        </Container>
                    </Section>
                );
       
			case 'block_text_image':
                const textImageData = component.block_data;
                const isImageRight = textImageData.image_position === 'right';
                return (
                    <Section class:list={"bg-white"}>
                        <Container>
                            <Hero>
                                <div slot={isImageRight ? "hero-content-left" : "hero-content-right"} class="prose">
                                    <h2 class="h2 text-teal-500">{textImageData.headline}</h2>
                                    <div class="leading-loose" set:html={textImageData.content} />

                                    {textImageData.show_button && textImageData.url_button && (
                                        <div class="not-prose mt-16">
                                            <Button url={textImageData.url_button.url}>
                                                {/* Puedes añadir un SVG si quieres */}
                                                {textImageData.text_button}
                                            </Button>
                                        </div>
                                    )}
                                </div>
                                
                                <div slot={isImageRight ? "hero-content-right" : "hero-content-left"} class:list={["-rotate-1"]}>
                                    {textImageData.image &&
                                    	<Image 
										src={textImageData.image.url} 
										alt={textImageData.image.alt ?? ''} 
										width={textImageData.image.width}
										height={textImageData.image.height}
										class:list={"w-full h-full object-cover rounded-2xl shadow"} 
										/>
                                    }
                                </div>
                            </Hero>
                        </Container>
                    </Section>
                );


			case 'block_featured_pets':
                const featuredPetsData = component.block_data;
                return (
                    <Section>
                        <Container>
                            <Heading>
                                <h2 slot="heading-title" class="h2 text-teal-500">{featuredPetsData.headline}</h2>
                                <p slot="heading-content">
                                    {featuredPetsData.intro_content}
                                </p>
                            </Heading>

                            <ShowPets petIDs={featuredPetsData.featured_pets} />
                        </Container>
                    </Section>
                );
        }
    })}
	
</Layout>
